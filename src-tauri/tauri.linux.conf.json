{
  "app": {
    "windows": [
      {
        "title": "OnKey",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "rpm"],
    "linux": {
      "deb": { "depends": ["ffmpeg", "libpipewire-0.3-0"] },
      "rpm": { "depends": ["ffmpeg-free", "pipewire-libs"] }
    }
  }
}
